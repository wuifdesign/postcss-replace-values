{
  "compilerOptions": {
    "target": "es2021",
    "lib": ["es2021"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": [],
    "strict": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "./lib"
  ],
  "exclude": [
    "node_modules"
  ]
}
