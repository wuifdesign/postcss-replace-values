{
  "name": "postcss-replace-values",
  "version": "4.0.0",
  "description": "PostCSS plugin to replace values like colors and CSS variables in declarations, with shorthand hex matching and optional selector filters",
  "keywords": [
    "postcss",
    "postcss-plugin",
    "color",
    "replace",
    "css-variables"
  ],
  "homepage": "https://github.com/wuifdesign/postcss-replace-values",
  "bugs": {
    "url": "https://github.com/wuifdesign/postcss-replace-values/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuifdesign/postcss-replace-values.git"
  },
  "license": "MIT",
  "author": "WuifDesign",
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sbx": "sbx run --name claude-postcss-replace-values",
    "build": "tsdown --config-loader native",
    "typecheck": "tsc",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --deny-warnings --fix",
    "test": "vitest run",
    "lint:package": "publint --strict",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run build && npm test"
  },
  "peerDependencies": {
    "postcss": "^8.0.0"
  },
  "devDependencies": {
    "oxlint": "^1.89.0",
    "postcss": "^8.5.31",
    "publint": "^0.3.25",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "volta": {
    "node": "24.22.1"
  }
}
